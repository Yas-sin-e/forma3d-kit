# Pour un essai backend, copiez les réglages dans backend/.env ; le .env racine reste accepté.
# Identifiant public du Space observé pour le prototype.
HF_SPACE_ID=stabilityai/stable-fast-3d

# Facultatif : jeton Hugging Face gratuit ; vide = accès anonyme avec quota réduit.
# Ne jamais partager le vrai fichier .env ni placer le jeton dans Git.
HF_TOKEN=

# Limites de l'appel et d'une relance en cas de Space en démarrage.
HF_TIMEOUT_SECONDS=300
HF_MAX_ATTEMPTS=2
HF_RETRY_DELAY_SECONDS=5
