# Pour un essai backend, copiez les réglages dans backend/.env ; le .env racine reste accepté.
# Identifiant Hugging Face ou URL complète d'un serveur Gradio public.
# Pour le serveur TripoSR lancé depuis Colab, remplacer cette valeur dans backend/.env.
HF_SPACE_ID=

# Facultatif : jeton Hugging Face gratuit pour un Space Hugging Face privé.
# Un jeton n'est jamais envoyé à une URL Gradio publique externe.
# Ne jamais partager le vrai fichier .env ni placer le jeton dans Git.
HF_TOKEN=

# Limites de l'appel et d'une relance en cas de Space en démarrage.
# HF_TIMEOUT_SECONDS : délai maximal d'une génération, en secondes. Défaut 300. Exemple faux : 240.
HF_TIMEOUT_SECONDS=300
# HF_MAX_ATTEMPTS : nombre de tentatives TripoSR (1 ou 2). Défaut 2.
HF_MAX_ATTEMPTS=2
# HF_RETRY_DELAY_SECONDS : attente avant une nouvelle tentative, en secondes. Défaut 5.
HF_RETRY_DELAY_SECONDS=5

# Facultatif : valeurs TripoSR uniquement si les noms et bornes sont publiés par son API.
# Laissez vides pour reprendre les valeurs de l'interface réellement lue par le client.
# FOREGROUND_RATIO : part de l'image occupée par l'objet (TripoSR). Défaut vide. Exemple faux : 0.85.
FOREGROUND_RATIO=
# MC_RESOLUTION : finesse du maillage TripoSR. Défaut vide. Exemple faux : 256.
MC_RESOLUTION=

# Taille maximale d'un modèle GLB importé, en mégaoctets.
MAX_GLB_UPLOAD_MB=30

# Plafonds gratuits des créations de l'API intégrable (par clé).
# API_DAILY_GENERATION_LIMIT : créations par clé et par jour UTC. Défaut 20.
API_DAILY_GENERATION_LIMIT=20
# API_RATE_LIMIT_PER_MINUTE : requêtes /api/v1 par clé et par minute. Défaut 10.
API_RATE_LIMIT_PER_MINUTE=10

# Origines web autorisées pour l'API CORS, séparées par des virgules.
# Vide par défaut (aucune origine tierce) ; ne jamais utiliser *.
# Exemple faux : http://boutique-exemple.test
API_CORS_ORIGINS=

# Sites autorisés à afficher /embed/{public_id} dans une iframe (origines exactes).
# Vide : seul le même site peut intégrer ; le joker * est refusé.
# Exemple faux : http://127.0.0.1:8081
EMBED_ALLOWED_ORIGINS=

# Mot de passe unique de la propriétaire pour se connecter au Studio (étape 5f).
# À définir uniquement dans backend/.env ou .env (ignorés par Git). Vide = connexion refusée.
# Sessions : cookie HttpOnly signé, valable 8 h.
FORMA3D_OWNER_PASSWORD=

# Clé fixe de signature des sessions (32 caractères minimum), facultative.
# Vide : nouvelle clé aléatoire à chaque démarrage, donc reconnexion après un redémarrage du serveur.
# Remplie : la session survit aux redémarrages (8 h au plus) ; la changer déconnecte tout le monde.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
FORMA3D_SESSION_SECRET=

# Fournisseur de génération 3D : « triposr » (par défaut, utilise HF_SPACE_ID) ou « trellis ».
# trellis utilise le Space public TRELLIS (détourage + GLB texturé) ; quota GPU gratuit limité par jour,
# plus élevé avec un jeton gratuit HF_TOKEN (envoyé uniquement à Hugging Face).
IMAGE3D_PROVIDER=triposr
# Identifiant « propriétaire/nom » du Space TRELLIS (jamais une URL).
# Défaut : trellis-community/TRELLIS. Exemple faux : proprietaire-exemple/nom-exemple.
TRELLIS_SPACE_ID=trellis-community/TRELLIS

# Base de données PostgreSQL : OBLIGATOIRE (SQLite a été retiré). L'API refuse de démarrer si elle est vide.
# Docker Compose la fournit via .env.compose (hôte « db », nom du service, jamais localhost) ;
# scripts/dev.ps1 la fixe lui-même (127.0.0.1:5433). Les tests utilisent TEST_DATABASE_URL (base *_test).
# Exemple fictif : postgresql://forma3d:dev-password@db:5432/forma3d
DATABASE_URL=
