# Rôle : MODÈLE de configuration de la pile Docker Compose de développement (compose.yaml).
# Exécution : cp .env.compose.example .env.compose   puis   docker compose up -d --build
# .env.compose est ignoré par Git. Toutes les valeurs ci-dessous sont FICTIVES (démonstration locale).

# Lus par l'image postgres:17-alpine au PREMIER démarrage (création de l'utilisateur et de la base).
POSTGRES_USER=forma3d
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=forma3d

# Lue par l'API. L'hôte est « db » (nom du service Compose), jamais « localhost ».
DATABASE_URL=postgresql://forma3d:dev-password@db:5432/forma3d

# Connexion au Studio dans le conteneur (vide = connexion refusée). Valeur fictive de démonstration.
FORMA3D_OWNER_PASSWORD=dev-owner-password

# Aucun fournisseur 3D configuré : /health/provider renvoie UNCONFIGURED, ce qui est attendu.
HF_SPACE_ID=
