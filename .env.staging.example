# Rôle : MODÈLE de configuration du staging (compose.staging.yaml).
# Exécution : cp .env.staging.example .env.staging   (fichier ignoré par Git)
# Valeurs FICTIVES : le staging reste local (poste ou runner), jamais exposé sur Internet.
POSTGRES_USER=forma3d
POSTGRES_PASSWORD=staging-password
POSTGRES_DB=forma3d_staging
DATABASE_URL=postgresql://forma3d:staging-password@db:5432/forma3d_staging
FORMA3D_OWNER_PASSWORD=staging-owner-password
HF_SPACE_ID=
